# Copy to `.env` and fill in. `.env` is gitignored; this file is the template.
#
# BOTH ARE OPTIONAL. With neither set, the app behaves exactly as it always has:
# local-first, no accounts, no network calls to Supabase, and the Supabase SDK
# is never even downloaded (it is behind a dynamic import). Do not add either
# variable "to be safe" — a half-configured project is worse than none.
#
# Setup steps: docs/AUTH.md → "Turning accounts on".

# Project URL. Supabase dashboard → Project Settings → API → Project URL.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The ANON / publishable key — NOT the service_role key.
#
# This one is meant to be public: it is compiled into the client bundle and
# anyone can read it out. It is safe only because row-level security is what
# actually restricts access (supabase/migrations/0001_journals_e2ee.sql), and
# because the row holds ciphertext this project cannot decrypt either way.
#
# The service_role key bypasses RLS entirely. It must never appear in a
# VITE_-prefixed variable, in this file, or anywhere in this repo.
VITE_SUPABASE_ANON_KEY=your-anon-key
